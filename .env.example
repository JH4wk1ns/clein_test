# Database Configuration
DATABASE_PATH=./data/trading.db

# Trading API Configuration (for production use)
TRADING_API_KEY=your_trading_api_key_here
TRADING_API_SECRET=your_trading_api_secret_here
TRADING_API_BASE_URL=https://api.tradingplatform.com

# News API Configuration (for production use)
NEWS_API_KEY=your_news_api_key_here
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# System Configuration
MAX_INVESTMENT_PERCENT=0.10
INITIAL_BALANCE=10000
LOG_LEVEL=info

# Scheduling Configuration (cron expressions)
NEWS_SCAN_SCHEDULE=*/30 * * * *
STOCK_ANALYSIS_SCHEDULE=0 * * * *
TRADE_EXECUTION_SCHEDULE=0 */2 * * *

# Risk Management
MAX_POSITION_SIZE=0.20
STOP_LOSS_PERCENT=0.05
TAKE_PROFIT_PERCENT=0.10
